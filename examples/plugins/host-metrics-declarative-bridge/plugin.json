{
  "id": "wprint3d.host-metrics-declarative-bridge",
  "name": "Host Metrics Bridge",
  "version": "0.1.0",
  "sdkVersion": 1,
  "sdkRevision": 1,
  "minCoreVersion": "0.0.0",
  "description": "Host metrics example using the bridge runtime and declarative settings UI.",
  "author": "WPrint 3D",
  "icon": "server-network",
  "runtime": {
    "type": "bridge",
    "baseUrl": "http://127.0.0.1:9310"
  },
  "permissions": [
    "host.metrics.read",
    "ui.navbar_widget",
    "ui.settings_tab"
  ],
  "components": [
    {
      "id": "hostMetricsPanel",
      "kind": "remote_component",
      "schema": {
        "component": "section",
        "title": {
          "$prop": "title",
          "default": "Host telemetry"
        },
        "subtitle": {
          "$prop": "subtitle",
          "default": "Remote component API"
        },
        "children": [
          {
            "component": "text",
            "text": "{{description}}"
          },
          {
            "component": "progress_cluster",
            "dataActionId": {
              "$prop": "dataActionId",
              "default": "host_metrics"
            },
            "pollIntervalMs": {
              "$prop": "pollIntervalMs",
              "default": 10000
            },
            "items": [
              {
                "id": "cpu",
                "label": "CPU",
                "valueKey": "cpu.usedPercentage"
              },
              {
                "id": "ram",
                "label": "RAM",
                "valueKey": "ram.usedPercentage"
              }
            ]
          }
        ]
      }
    }
  ],
  "actions": [
    {
      "id": "host_metrics",
      "label": "Read host metrics",
      "path": "/actions/host_metrics"
    }
  ],
  "uiExtensions": [
    {
      "id": "host-metrics-settings",
      "surface": "settings_tab",
      "mode": "declarative",
      "title": "Host Metrics",
      "schema": {
        "component": "remote_component",
        "componentId": "hostMetricsPanel",
        "props": {
          "title": "Host telemetry",
          "subtitle": "Bridge runtime + remote component UI",
          "description": "This settings tab uses the same host-rendered remote component API while fetching telemetry from the external bridge service.",
          "dataActionId": "host_metrics",
          "pollIntervalMs": 10000
        }
      }
    },
    {
      "id": "host-metrics-navbar",
      "surface": "navbar_widget",
      "mode": "declarative",
      "title": "Host Metrics",
      "schema": {
        "component": "progress_cluster",
        "dataActionId": "host_metrics",
        "pollIntervalMs": 10000,
        "items": [
          {
            "id": "cpu",
            "label": "CPU",
            "valueKey": "cpu.usedPercentage"
          },
          {
            "id": "ram",
            "label": "RAM",
            "valueKey": "ram.usedPercentage"
          }
        ]
      }
    }
  ],
  "signature": {
    "algorithm": "none"
  }
}
