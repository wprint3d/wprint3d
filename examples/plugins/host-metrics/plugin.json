{
  "id": "wprint3d.host-metrics",
  "name": "Host Metrics",
  "version": "0.1.0",
  "sdkVersion": 1,
  "minCoreVersion": "0.0.0",
  "description": "Adds compact CPU and RAM progress bars to the top navigation bar.",
  "author": "WPrint 3D",
  "runtime": {
    "type": "php",
    "entry": "plugin.php"
  },
  "permissions": [
    "host.metrics.read",
    "ui.navbar_widget"
  ],
  "actions": [
    {
      "id": "host_metrics",
      "label": "Read host metrics",
      "handler": "actions/host_metrics.php"
    }
  ],
  "uiExtensions": [
    {
      "id": "host-metrics-navbar",
      "surface": "navbar_widget",
      "mode": "declarative",
      "title": "Host Metrics",
      "schema": {
        "component": "progress_cluster",
        "dataActionId": "host_metrics",
        "pollIntervalMs": 10000,
        "items": [
          {
            "id": "cpu",
            "label": "CPU",
            "valueKey": "cpu.usedPercentage"
          },
          {
            "id": "ram",
            "label": "RAM",
            "valueKey": "ram.usedPercentage"
          }
        ]
      }
    }
  ],
  "signature": {
    "algorithm": "none"
  }
}
